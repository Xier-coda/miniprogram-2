/* pages/order/order.wxss */.orders-page {
  padding: 20rpx;
}

.order-card {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
}

.order-header {
  display: flex;
  justify-content: space-between;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.order-item {
  margin-left: 20rpx;
  margin-top: 8rpx;
  color: #333;
}

.empty {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
}