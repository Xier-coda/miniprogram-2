/* pages/cart/cart.wxss */
.cart-container {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.cart-img {
  width: 150rpx;
  height: 150rpx;
}

.cart-info {
  padding: 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
}

.price, .count {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #555;
}

.empty {
  text-align: center;
  margin-top: 100rpx;
  color: #888;
  font-size: 32rpx;
}

.actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}
.actions button:not(:last-child) {
  margin-right: 10rpx;
}
.cart-footer {
  position: fixed;
  bottom: 0;
  width: 100%;
  background-color: #ffffff;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.total-price {
  font-size: 32rpx;
  color: #333333;
}

.checkout-btn {
  background-color: #ff4444;
  color: white;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
}